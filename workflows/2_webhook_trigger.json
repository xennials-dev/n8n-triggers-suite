{
  "name": "Local Trigger 2 - Incoming Webhook Receiver",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "local-api-webhook",
        "responseMode": "responseNode",
        "options": {
          "rawBody": false
        }
      },
      "id": "webhook-trigger-node",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        300
      ],
      "webhookId": "local-api-webhook"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "param-1",
              "name": "receivedPayload",
              "value": "={{ $json.body }}",
              "type": "object"
            },
            {
              "id": "param-2",
              "name": "headers",
              "value": "={{ $json.headers }}",
              "type": "object"
            },
            {
              "id": "param-3",
              "name": "processedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "webhook-metadata-edit",
      "name": "Format Request Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"success\",\n  \"message\": \"Local webhook triggered successfully\",\n  \"receivedPayload\": {{ JSON.stringify($json.receivedPayload) }},\n  \"timestamp\": \"{{ $json.processedAt }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-webhook-node",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        700,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Format Request Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Request Data": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
